<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="AO Logbook" />
  <meta name="theme-color" content="#0f4c81" />
  <title>AO Logbook</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f8fafc;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .container {
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100dvh;
      background: #fff;
    }
    .header {
      background: linear-gradient(135deg, #0f4c81 0%, #1a6fb5 100%);
      color: #fff;
      padding: max(1rem, env(safe-area-inset-top)) 1rem 1rem;
      text-align: center;
      flex-shrink: 0;
    }
    .header h1 { font-size: 1.3rem; font-weight: 700; }
    .header small { font-size: 0.75rem; opacity: 0.8; }

    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      -webkit-overflow-scrolling: touch;
    }
    .msg {
      padding: 0.75rem 1rem;
      border-radius: 14px;
      max-width: 85%;
      word-wrap: break-word;
      font-size: 0.95rem;
      line-height: 1.5;
      white-space: pre-wrap;
    }
    .msg.bot {
      background: #e8f1f8;
      color: #1a2a3a;
      align-self: flex-start;
      border-bottom-left-radius: 4px;
    }
    .msg.user {
      background: #0f4c81;
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }
    .msg.error {
      background: #fee2e2;
      color: #991b1b;
      align-self: flex-start;
      font-size: 0.85rem;
    }

    .typing {
      padding: 0.75rem 1rem;
      border-radius: 14px;
      background: #e8f1f8;
      align-self: flex-start;
      border-bottom-left-radius: 4px;
    }
    .typing span {
      display: inline-block;
      width: 7px; height: 7px;
      background: #0f4c81;
      border-radius: 50%;
      margin: 0 2px;
      animation: bounce 1.4s infinite;
    }
    .typing span:nth-child(2) { animation-delay: 0.2s; }
    .typing span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce {
      0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
      40% { transform: translateY(-6px); opacity: 1; }
    }

    .input-area {
      display: flex;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
      background: #fff;
      border-top: 1px solid #e2e8f0;
      flex-shrink: 0;
    }
    .input-area textarea {
      flex: 1;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      padding: 0.65rem 0.75rem;
      font-size: 1rem;
      font-family: inherit;
      outline: none;
      resize: none;
      min-height: 42px;
      max-height: 120px;
      line-height: 1.4;
    }
    .input-area textarea:focus {
      border-color: #0f4c81;
      box-shadow: 0 0 0 3px rgba(15,76,129,0.1);
    }
    .input-area button {
      background: #0f4c81;
      color: #fff;
      border: none;
      border-radius: 10px;
      width: 44px;
      height: 44px;
      font-size: 1.3rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      align-self: flex-end;
    }
    .input-area button:disabled { opacity: 0.5; }
    .input-area button:active { opacity: 0.8; }
  </style>
</head>
<body>

<div class="container">
  <div class="header">
    <h1>🚑 AO Logbook</h1>
    <small>Ambulance Officer Assistant</small>
  </div>

  <div class="messages" id="messages">
    <div class="msg bot">G'day! I'm your AO Logbook assistant. Ask me anything about logbook entries, protocols, or documentation.</div>
  </div>

  <div class="input-area">
    <textarea id="input" rows="1" placeholder="Type a message…"
      oninput="autoResize(this)"
      onkeydown="handleKey(event)"></textarea>
    <button id="sendBtn" onclick="send()">➤</button>
  </div>
</div>

<script>
  const API_KEY = 'sk_HHx-o53xl3oLOkQ6tp9byHBqGvtDUAWcpFl8jeh_CEo';
  const API_URL = 'https://simtheory.ai/api/v1/chat/completions';
  const MODEL   = 'automatic';

  const SYSTEM_PROMPT = `You are a helpful assistant for Australian volunteer ambulance officers. You help with:
- Logbook entries and documentation
- Clinical protocols and procedures
- Patient assessment documentation
- Incident reporting standards
Be concise, practical, and use Australian terminology. Format responses clearly.`;

  let history = [];
  let sending = false;

  function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 120) + 'px';
  }

  function handleKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      send();
    }
  }

  async function send() {
    if (sending) return;
    const input = document.getElementById('input');
    const text = input.value.trim();
    if (!text) return;

    sending = true;
    document.getElementById('sendBtn').disabled = true;

    addMsg(text, 'user');
    input.value = '';
    input.style.height = 'auto';

    const typingEl = showTyping();

    try {
      history.push({ role: 'user', content: text });

      const res = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${API_KEY}`
        },
        body: JSON.stringify({
          model: MODEL,
          messages: [
            { role: 'system', content: SYSTEM_PROMPT },
            ...history.slice(-20)
          ]
        })
      });

      typingEl.remove();

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        const errMsg = errData?.error?.message || `Server error (${res.status})`;
        addMsg(errMsg, 'error');
        history.pop();
      } else {
        const data = await res.json();
        const reply = data.choices?.[0]?.message?.content || 'No response received.';
        addMsg(reply, 'bot');
        history.push({ role: 'assistant', content: reply });
      }

    } catch (err) {
      typingEl.remove();
      addMsg('Network error — check your connection and try again.', 'error');
      history.pop();
    }

    sending = false;
    document.getElementById('sendBtn').disabled = false;
    input.focus();
  }

  function addMsg(text, role) {
    const div = document.createElement('div');
    div.className = `msg ${role}`;
    div.textContent = text;
    const container = document.getElementById('messages');
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    const container = document.getElementById('messages');
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
    return div;
  }
</script>

</body>
</html>